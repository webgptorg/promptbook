{
    "comments": { "blockComment": ["<!--", "-->"] },
    "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "`", "close": "`" }
    ],
    "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["`", "`"], ["*", "*"], ["_", "_"]],
    "wordPattern": "[^\\s{}@`]+"
}
