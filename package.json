{
    "name": "ptbk",
    "version": "0.119.0-44",
    "description": "Autonomous AI agendas on your machine. Readable agents, your choice of models, and Git history under your control.",
    "private": false,
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/webgptorg/promptbook.git"
    },
    "author": "Pavol Hejný <pavol@ptbk.io> (https://www.pavolhejny.com/)",
    "contributors": [
        "Pavol Hejný <pavol@ptbk.io> (https://www.pavolhejny.com/)",
        "Jiří Jahn <jiri@ptbk.io> (https://www.ptbk.io/)"
    ],
    "license": "BUSL-1.1",
    "bugs": {
        "url": "https://github.com/webgptorg/promptbook/issues"
    },
    "homepage": "https://ptbk.io/",
    "scripts": {
        "start": "npm run build && node bin/ptbk.js",
        "ptbk": "npm run build && node bin/ptbk.js",
        "build": "node scripts/build.mjs && npm run build:vscode",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run build && node scripts/test.mjs",
        "test:package": "npm run build && node scripts/test-package.mjs",
        "check": "npm run check:light",
        "check:light": "npm run typecheck",
        "check:full": "npm run typecheck && npm run typecheck:vscode && npm test && npm run test:vscode && npm run test:package && npm run package:vscode",
        "preversion": "node scripts/preversion.mjs && npm run check:full && npm run release:validate",
        "postversion": "node scripts/postversion.mjs",
        "prepack": "npm run build",
        "prepublishOnly": "node scripts/assert-publish-context.mjs",
        "release:validate": "node scripts/validate-release.mjs",
        "release:publish": "node scripts/publish.mjs",
        "release:verify": "node scripts/verify-published.mjs",
        "release:patch": "npm version patch",
        "release:minor": "npm version minor",
        "release:major": "npm version major",
        "release:prerelease": "npm version prerelease",
        "release:preminor": "npm version preminor",
        "build:vscode": "node scripts/build-vscode.mjs",
        "typecheck:vscode": "tsc -p extensions/vscode/tsconfig.json",
        "test:vscode": "npm run build:vscode && node --test extensions/vscode/test/language.test.mjs extensions/vscode/test/package.test.mjs",
        "package:vscode": "npm run build:vscode && node scripts/package-vscode.mjs",
        "release:vscode": "node scripts/publish-vscode.mjs"
    },
    "engines": {
        "node": "^22.13.0 || >=24",
        "npm": ">=10"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "22.20.5",
        "@types/vscode": "1.85.0",
        "@vscode/vsce": "4.1.0",
        "cspell": "9.0.2",
        "esbuild": "0.28.2",
        "eslint": "10.12.0",
        "globals": "16.5.0",
        "jszip": "3.10.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.1"
    },
    "bin": {
        "ptbk": "bin/ptbk.js"
    },
    "files": [
        "bin/",
        "dist/",
        "README.md",
        "LICENSE.md",
        "CHANGELOG.md"
    ],
    "keywords": [
        "cli",
        "coding-agent",
        "promptbook",
        "task-automation",
        "book-language"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "dependencies": {
        "@scure/bip39": "2.4.0"
    }
}
