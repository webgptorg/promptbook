{
    "name": "ptbk",
    "version": "0.119.0-5",
    "description": "Promptbook command-line utility for agent, project and task workflows.",
    "private": false,
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/webgptorg/promptbook.git"
    },
    "author": "Pavol Hejný <pavol@ptbk.io> (https://www.pavolhejny.com/)",
    "contributors": [
        "Pavol Hejný <pavol@ptbk.io> (https://www.pavolhejny.com/)",
        "Jiří Jahn <jiri@ptbk.io> (https://www.ptbk.io/)"
    ],
    "license": "BUSL-1.1",
    "bugs": {
        "url": "https://github.com/webgptorg/promptbook/issues"
    },
    "homepage": "https://ptbk.io/",
    "scripts": {
        "start": "npm run build && node bin/ptbk.js",
        "ptbk": "npm run build && node bin/ptbk.js",
        "build": "node scripts/build.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run build && node scripts/test.mjs",
        "check": "npm run typecheck && npm test && npm run test:package",
        "test:package": "npm run build && node scripts/test-package.mjs",
        "preversion": "node scripts/preversion.mjs && npm run typecheck && npm run release:validate",
        "postversion": "node scripts/postversion.mjs",
        "prepack": "npm run build",
        "prepublishOnly": "node scripts/assert-publish-context.mjs && npm run check",
        "release:preminor": "npm version preminor",
        "release:prerelease": "npm version prerelease",
        "release:publish": "node scripts/publish.mjs",
        "release:validate": "node scripts/validate-release.mjs",
        "release:verify": "node scripts/verify-published.mjs",
        "release:patch": "npm version patch",
        "release:minor": "npm version minor",
        "release:major": "npm version major"
    },
    "engines": {
        "node": "^22.13.0 || >=24",
        "npm": ">=10"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "22.20.5",
        "@types/qrcode": "1.5.6",
        "cspell": "9.0.2",
        "eslint": "10.12.0",
        "globals": "16.5.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.1"
    },
    "bin": {
        "ptbk": "bin/ptbk.js"
    },
    "files": [
        "bin/",
        "dist/",
        "README.md",
        "LICENSE.md",
        "CHANGELOG.md",
        "docs/releasing.md",
        "docs/runtime.md",
        "docs/compatibility.md",
        "changelog/_current-preversion.md"
    ],
    "keywords": [
        "cli",
        "coding-agent",
        "promptbook",
        "task-automation",
        "book-language"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "dependencies": {
        "qrcode": "1.5.4"
    }
}
