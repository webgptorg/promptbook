{
    "name": "ptbk",
    "version": "0.115.0-5",
    "description": "A local coding agent CLI with Book tasks, safe Git persistence, scheduling and interchangeable coding harnesses.",
    "private": false,
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/webgptorg/promptbook.git"
    },
    "author": "Pavol Hejný <pavol@ptbk.io> (https://www.pavolhejny.com/)",
    "contributors": [
        "Pavol Hejný <pavol@ptbk.io> (https://www.pavolhejny.com/)",
        "Jiří Jahn <jiri@ptbk.io> (https://www.ptbk.io/)"
    ],
    "license": "BUSL-1.1",
    "bugs": {
        "url": "https://github.com/webgptorg/promptbook/issues"
    },
    "homepage": "https://ptbk.io/",
    "scripts": {
        "start": "npm run coder:run",
        "build": "node scripts/build.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run build && node --test test/*.test.mjs",
        "check": "npm run typecheck && npm test && npm run test:package",
        "test:package": "node scripts/test-package.mjs",
        "preversion": "npm run typecheck && npm run release:validate && node scripts/preversion.mjs",
        "postversion": "node scripts/postversion.mjs",
        "prepack": "npm run build",
        "prepublishOnly": "node scripts/assert-publish-context.mjs && npm run check",
        "release:preminor": "npm version preminor",
        "release:prerelease": "npm version prerelease",
        "release:publish": "node scripts/publish.mjs",
        "release:validate": "node scripts/validate-release.mjs",
        "release:verify": "node scripts/verify-published.mjs",
        "coder:run": "npm run build && node bin/ptbk.js coder run --harness openai-codex --thinking-level max",
        "coder:list": "npm run build && node bin/ptbk.js coder list"
    },
    "engines": {
        "node": "^22.13.0 || >=24",
        "npm": ">=10"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "cspell": "9.0.2",
        "eslint": "10.12.0",
        "globals": "16.5.0",
        "typescript-eslint": "8.71.1",
        "typescript": "6.0.3",
        "@types/node": "22.20.5"
    },
    "bin": {
        "ptbk": "bin/ptbk.js"
    },
    "files": [
        "bin/",
        "dist/",
        "README.md",
        "LICENSE.md",
        "CHANGELOG.md",
        "docs/coder.md",
        "docs/compatibility.md",
        "changelog/_current-preversion.md"
    ],
    "keywords": [
        "cli",
        "coding-agent",
        "promptbook",
        "task-automation",
        "book-language"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
